modules = ["nodejs-20", "web"]
run = "cd project && npm run build && npm run preview"

[nix]
channel = "stable-24_05"
packages = ["xsel"]

[deployment]
run = ["sh", "-c", "cd project && npx vite preview --host 0.0.0.0 --port 5000"]
build = ["sh", "-c", "cd project && npm run build"]
deploymentTarget = "cloudrun"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5173
externalPort = 5173

[[ports]]
localPort = 41005
externalPort = 3000

[workflows]
runButton = "Build and Serve"

[[workflows.workflow]]
name = "Build and Preview"
author = 42167165
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd project && npm run build"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd project && npm run preview"

[[workflows.workflow]]
name = "Build and Serve"
author = 42167165
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd project && npm run build"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd project && npx serve dist -s -l 5000"

[[workflows.workflow]]
name = "Run"
author = 42167165
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd project && npm run dev"

[agent]
expertMode = true
