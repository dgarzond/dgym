modules = ["nodejs-20", "web"]
run = "npm run dev"

[nix]
channel = "stable-24_05"

[deployment]
run = ["sh", "-c", "npm run dev"]

[[ports]]
localPort = 5173
externalPort = 5000
exposeLocalhost = true

[workflows]

[[workflows.workflow]]
name = "Build and Preview"
author = 42167165
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd project && npm run build"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd project && npm run preview"
