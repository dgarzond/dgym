modules = ["nodejs-20", "web", "postgresql-16"]
run = "cd project && npm run build && npm run preview"

[nix]
channel = "stable-24_05"
packages = ["xsel"]

[deployment]
run = ["sh", "-c", "cd server && npx tsx production.ts & npx http-server project/dist -p 5000 --cors -o -c-1 -P 'https://1686d593-7808-47b3-935f-bec5984a401a-00-2im67zmmqmesb.worf.replit.dev:3001'"]
build = ["sh", "-c", "cd project && npm run build"]
deploymentTarget = "cloudrun"

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5173
externalPort = 5000

[[ports]]
localPort = 5174
externalPort = 3002

[[ports]]
localPort = 41005
externalPort = 3000

[workflows]
runButton = "Full Stack Dev"

[[workflows.workflow]]
name = "Build and Preview"
author = 42167165
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd project && npm run build"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd project && npm run preview"

[[workflows.workflow]]
name = "Build and Serve"
author = 42167165
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd project && npm run build"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd project && npx serve dist -s -l 5000"

[[workflows.workflow]]
name = "Run"
author = 42167165
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd project && npm run dev"

[[workflows.workflow]]
name = "Full Stack Dev"
author = 42167165
mode = "parallel"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd server && npx tsx index.ts"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd project && npm run dev"

[agent]
expertMode = true
